\n    });\n  };\n  function doWrite(self, value, withResponse) {\n    var b64 = bytesToB64(value);\n    return request(function(id) {\n      bridge.wbWrite(id, self.service.device.id, self.service.uuid, self.uuid, b64, !!withResponse);\n    }).then(function() { return undefined; });\n  }\n  Characteristic.prototype.writeValue = function(v) { return doWrite(this, v, true); };\n  Characteristic.prototype.writeValueWithResponse = function(v) { return doWrite(this, v, true); };\n  Characteristic.prototype.writeValueWithoutResponse = function(v) { return doWrite(this, v, false); };\n\n  Characteristic.prototype.startNotifications = function() {\n    var self = this;\n    self.service.device.__notify[self.service.uuid + \'/\' + self.uuid] = self;\n    return request(function(id) {\n      bridge.wbNotify(id, self.service.device.id, self.service.uuid, self.uuid, true);\n    }).then(function() { return self; });\n  };\n  Characteristic.prototype.stopNotifications = function() {\n    var self = this;\n    delete self.service.device.__notify[self.service.uuid + \'/\' + self.uuid];\n    return request(function(id) {\n      bridge.wbNotify(id, self.service.device.id, self.service.uuid, self.uuid, false);\n    }).then(function() { return self; });\n  };\n  Characteristic.prototype.getDescriptor = function() {\n    return Promise.reject(domError(\'NotSupportedError\', \'Descriptors are not available in this app\'));\n  };\n\n  // \u2500\u2500 Service \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  function Service(device, uuid) {\n    this.device = device;\n    this.uuid = uuid;\n    this.isPrimary = true;\n    this.__chars = null;\n  }\n  Service.proto