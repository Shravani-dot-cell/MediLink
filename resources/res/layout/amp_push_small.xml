<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/amp_small_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/amp_small_fill"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/amp_push_round"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/amp_small_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:ellipsize="end"
                android:id="@+id/amp_small_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/TextAppearance.Compat.Notification.Title"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/amp_small_body"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/TextAppearance.Compat.Notification"/>
        </LinearLayout>
        <Chronometer
            android:textSize="16sp"
            android:textStyle="bold"
            android:id="@+id/amp_small_timer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            style="@style/TextAppearance.Compat.Notification.Title"/>
        <FrameLayout
            android:id="@+id/amp_small_cta"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp">
            <ImageView
                android:id="@+id/amp_small_cta_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/amp_push_pill"
                android:scaleType="fitXY"
                android:importantForAccessibility="no"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:id="@+id/amp_small_cta_text"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="120dp"
                android:singleLine="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/amp_small_thumb"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</FrameLayout>
