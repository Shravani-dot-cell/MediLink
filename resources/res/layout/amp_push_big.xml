<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/amp_big_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/amp_big_fill"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/amp_push_round"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/amp_big_col"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/amp_badge_box"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">
            <ImageView
                android:id="@+id/amp_badge_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/amp_push_pill"
                android:scaleType="fitXY"
                android:layout_alignTop="@+id/amp_badge"
                android:layout_alignBottom="@+id/amp_badge"
                android:importantForAccessibility="no"
                android:layout_alignStart="@+id/amp_badge"
                android:layout_alignEnd="@+id/amp_badge"/>
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:id="@+id/amp_badge"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAllCaps="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/amp_avatar"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/amp_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_weight="1"
                style="@style/TextAppearance.Compat.Notification.Title"/>
        </LinearLayout>
        <TextView
            android:ellipsize="end"
            android:id="@+id/amp_body"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="3"
            style="@style/TextAppearance.Compat.Notification"/>
        <Chronometer
            android:textSize="28sp"
            android:textStyle="bold"
            android:id="@+id/amp_timer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            style="@style/TextAppearance.Compat.Notification.Title"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/amp_timer_caption"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/TextAppearance.Compat.Notification.Info"/>
        <ImageView
            android:id="@+id/amp_image_l"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"/>
        <ImageView
            android:id="@+id/amp_image_m"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"/>
        <ImageView
            android:id="@+id/amp_image_s"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"/>
        <FrameLayout
            android:id="@+id/amp_cta"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <ImageView
                android:id="@+id/amp_cta_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/amp_push_pill"
                android:scaleType="fitXY"
                android:importantForAccessibility="no"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/amp_cta_text"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
